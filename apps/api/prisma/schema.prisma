generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  OFFICE
  WORKER
}

enum TeamStatus {
  ACTIVE
  INACTIVE
}

enum JobStatus {
  PLANNED
  IN_PROGRESS
  DONE
  CANCELED
}

enum JobPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum JobActivityKind {
  STATUS
  NOTE
  REPORT
}

enum ReportReviewStatus {
  SUBMITTED
  PENDING_REVIEW
  APPROVED
  NEEDS_REVISION
  REJECTED
}

enum JobReportType {
  GENERAL
  WORKER_FINDING
  WORK_COMPLETION
  INCIDENT_REPORT
  FOLLOW_UP_REQUEST
}

enum AttachmentKind {
  PHOTO
  FILE
}

enum CustomerType {
  PRIVATE
  BUSINESS
  PROPERTY_MANAGEMENT
  OTHER
}

enum ObjectType {
  BUILDING
  GARDEN
  WAREHOUSE
  CONSTRUCTION_SITE
  OFFICE
  FACILITY
  OTHER
}

enum ObjectStatus {
  ACTIVE
  INACTIVE
}

enum ObjectAreaType {
  STAIRCASE
  BASEMENT
  ENTRANCE
  PARKING
  GARDEN_AREA
  ROOM
  STORAGE_AREA
  OTHER
}

enum ItemKind {
  MATERIAL
  TOOL
  ASSET
  CONSUMABLE
  PACKAGE
  OTHER
}

enum ItemUnit {
  PIECE
  KG
  LITER
  METER
  SQUARE_METER
  CUBIC_METER
  PALLET
  BOX
  BAG
  OTHER
}

enum ItemTrackingMode {
  QUANTITY
  SERIALIZED
}

enum ItemStatus {
  ACTIVE
  INACTIVE
  DAMAGED
  LOST
  ARCHIVED
}

enum JobCostKind {
  MATERIAL_PURCHASE
  MATERIAL_USED
  LABOR
  TRAVEL
  EXTERNAL_SERVICE
  FEE
  OTHER
}

enum JobCostUnit {
  PIECE
  HOUR
  KILOMETER
  KG
  LITER
  METER
  SQUARE_METER
  CUBIC_METER
  FLAT_RATE
  OTHER
}

enum AssignmentEntityType {
  USER
  TEAM
  JOB
  CUSTOMER
  ADDRESS
  OBJECT
  OBJECT_AREA
  ITEM
}

enum AssignmentKind {
  RESPONSIBLE
  SCHEDULED
  ALLOCATED
  RESERVED
  SUPPORTING
  OTHER
}

enum AssignmentStatus {
  ACTIVE
  PLANNED
  ENDED
  CANCELED
}

enum CustomerReportType {
  JOB_COMPLETION
  INCIDENT
  DAMAGE_REPORT
  MAINTENANCE
  OBJECT_STATUS
  COST_OVERVIEW
  OTHER
}

enum CustomerReportStatus {
  DRAFT
  READY_FOR_REVIEW
  APPROVED
  ARCHIVED
}

enum WorkdaySheetStatus {
  DRAFT
  SENT
  SUBMITTED
  REVIEWED
  ARCHIVED
}

enum WorksheetReviewActionType {
  CREATE_FOLLOW_UP_JOB
  CREATE_JOB_COST_LINE
  CREATE_JOB_REPORT
}

enum WorksheetReviewActionStatus {
  COMPLETED
}

enum ServiceAgreementStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum RecurringDutyCadenceUnit {
  DAY
  WEEK
  MONTH
  YEAR
}

model Company {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  memberships    Membership[]
  teams          Team[]
  jobs           Job[]
  reports        JobReport[]
  attachments    JobAttachment[]
  customers      Customer[]
  addresses      Address[]
  objects        Object[]
  objectAreas    ObjectArea[]
  itemCategories ItemCategory[]
  items          Item[]
  assignments    Assignment[]
  jobCostLines   JobCostLine[]
  customerReportSnapshots CustomerReportSnapshot[]
  workdaySheets  WorkdaySheet[]
  workdaySheetRows WorkdaySheetRow[]
  worksheetReviewActions WorksheetReviewAction[]
  serviceAgreements ServiceAgreement[]
  recurringObjectDuties RecurringObjectDuty[]
}

model User {
  id                  String          @id @default(cuid())
  email               String          @unique
  displayName         String?
  passwordHash        String?
  isActive            Boolean         @default(true)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  memberships         Membership[]
  teamMembers         TeamMember[]
  authoredReports     JobReport[]     @relation("JobReportAuthor")
  reviewedReports     JobReport[]     @relation("JobReportReviewer")
  uploadedAttachments JobAttachment[] @relation("JobAttachmentUploader")
  createdAssignments  Assignment[]    @relation("AssignmentCreatedBy")
  createdJobCostLines JobCostLine[]   @relation("JobCostLineCreatedBy")
  updatedJobCostLines JobCostLine[]   @relation("JobCostLineUpdatedBy")
  createdCustomerReports  CustomerReportSnapshot[] @relation("CustomerReportCreatedBy")
  approvedCustomerReports CustomerReportSnapshot[] @relation("CustomerReportApprovedBy")
  assignedWorkdaySheets  WorkdaySheet[] @relation("WorkdaySheetWorker")
  createdWorkdaySheets   WorkdaySheet[] @relation("WorkdaySheetCreatedBy")
  sentWorkdaySheets      WorkdaySheet[] @relation("WorkdaySheetSentBy")
  submittedWorkdaySheets WorkdaySheet[] @relation("WorkdaySheetSubmittedBy")
  reviewedWorkdaySheets  WorkdaySheet[] @relation("WorkdaySheetReviewedBy")
  archivedWorkdaySheets  WorkdaySheet[] @relation("WorkdaySheetArchivedBy")
  createdWorksheetReviewActions WorksheetReviewAction[] @relation("WorksheetReviewActionCreatedBy")
  createdServiceAgreements ServiceAgreement[] @relation("ServiceAgreementCreatedBy")
  updatedServiceAgreements ServiceAgreement[] @relation("ServiceAgreementUpdatedBy")
  activatedServiceAgreements ServiceAgreement[] @relation("ServiceAgreementActivatedBy")
  deactivatedServiceAgreements ServiceAgreement[] @relation("ServiceAgreementDeactivatedBy")
  archivedServiceAgreements ServiceAgreement[] @relation("ServiceAgreementArchivedBy")
  createdRecurringObjectDuties RecurringObjectDuty[] @relation("RecurringObjectDutyCreatedBy")
  updatedRecurringObjectDuties RecurringObjectDuty[] @relation("RecurringObjectDutyUpdatedBy")
}

model Membership {
  id        String         @id @default(cuid())
  userId    String
  companyId String
  role      MembershipRole
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([userId])
}

model Team {
  id                String          @id @default(cuid())
  companyId         String
  name              String
  code              String?
  specialty         String?
  status            TeamStatus      @default(ACTIVE)
  currentAssignment String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  members           TeamMember[]
  jobs              Job[]
  reports           JobReport[]
  attachments       JobAttachment[]
  workdaySheets     WorkdaySheet[]

  @@index([companyId])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  roleLabel String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model Job {
  id             String          @id @default(cuid())
  companyId      String
  teamId         String?
  customerId     String?
  addressId      String?
  objectId       String?
  objectAreaId   String?
  reference      String          @unique
  title          String
  description    String?
  customerName   String
  location       String
  scheduledStart DateTime
  scheduledEnd   DateTime?
  status         JobStatus       @default(PLANNED)
  priority       JobPriority     @default(NORMAL)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  team           Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  address        Address?        @relation(fields: [addressId], references: [id], onDelete: SetNull)
  object         Object?         @relation(fields: [objectId], references: [id], onDelete: SetNull)
  objectArea     ObjectArea?     @relation(fields: [objectAreaId], references: [id], onDelete: SetNull)
  activity       JobActivity[]
  reports        JobReport[]
  attachments    JobAttachment[]
  costLines      JobCostLine[]
  customerReportSnapshots CustomerReportSnapshot[]
  workdaySheetRows WorkdaySheetRow[]
  worksheetReviewActions WorksheetReviewAction[]

  @@index([companyId])
  @@index([teamId])
  @@index([companyId, customerId])
  @@index([companyId, addressId])
  @@index([companyId, objectId])
  @@index([companyId, objectAreaId])
  @@index([status])
}

model JobActivity {
  id         String          @id @default(cuid())
  jobId      String
  kind       JobActivityKind
  title      String
  content    String?
  authorName String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  job        Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([createdAt])
}

model JobReport {
  id               String             @id @default(cuid())
  companyId        String
  jobId            String
  teamId           String?
  authorUserId     String?
  reviewedByUserId String?
  type             JobReportType      @default(GENERAL)
  summary          String
  details          String?
  findingSummary   String?
  workPerformed    String?
  workStillNeeded  String?
  followUpRequired Boolean            @default(false)
  followUpNotes    String?
  reviewStatus     ReportReviewStatus @default(SUBMITTED)
  reviewedAt       DateTime?
  reviewNotes      String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  company          Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job              Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  team             Team?              @relation(fields: [teamId], references: [id], onDelete: SetNull)
  author           User?              @relation("JobReportAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  reviewer         User?              @relation("JobReportReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  attachments      JobAttachment[]
  worksheetReviewActions WorksheetReviewAction[]

  @@index([companyId])
  @@index([companyId, reviewStatus, createdAt])
  @@index([jobId, createdAt])
  @@index([teamId])
  @@index([authorUserId])
  @@index([reviewedByUserId])
}

model JobAttachment {
  id             String         @id @default(cuid())
  companyId      String
  jobId          String
  reportId       String?
  teamId         String?
  uploaderUserId String?
  kind           AttachmentKind
  storagePath    String
  fileName       String
  mimeType       String
  sizeBytes      Int
  caption        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job            Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  report         JobReport?     @relation(fields: [reportId], references: [id], onDelete: SetNull)
  team           Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  uploader       User?          @relation("JobAttachmentUploader", fields: [uploaderUserId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([jobId, createdAt])
  @@index([reportId])
  @@index([teamId])
  @@index([uploaderUserId])
  @@index([kind, createdAt])
}

model Customer {
  id        String       @id @default(cuid())
  companyId String
  name      String
  type      CustomerType @default(BUSINESS)
  email     String?
  phone     String?
  notes     String?
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  addresses Address[]
  objects   Object[]
  jobs      Job[]
  customerReportSnapshots CustomerReportSnapshot[]
  workdaySheetRows WorkdaySheetRow[]
  serviceAgreements ServiceAgreement[]

  @@index([companyId, name])
  @@index([companyId, isActive])
}

model Address {
  id         String    @id @default(cuid())
  companyId  String
  customerId String?
  label      String
  street     String
  postalCode String
  city       String
  country    String    @default("DE")
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  objects    Object[]
  jobs       Job[]
  customerReportSnapshots CustomerReportSnapshot[]
  workdaySheetRows WorkdaySheetRow[]
  serviceAgreements ServiceAgreement[]

  @@index([companyId, label])
  @@index([companyId, customerId])
}

model Object {
  id         String       @id @default(cuid())
  companyId  String
  customerId String?
  addressId  String?
  name       String
  type       ObjectType   @default(OTHER)
  status     ObjectStatus @default(ACTIVE)
  notes      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer   Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  address    Address?     @relation(fields: [addressId], references: [id], onDelete: SetNull)
  areas      ObjectArea[]
  jobs       Job[]
  customerReportSnapshots CustomerReportSnapshot[]
  workdaySheetRows WorkdaySheetRow[]
  serviceAgreements ServiceAgreement[]

  @@index([companyId, name])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@index([companyId, addressId])
}

model ObjectArea {
  id        String         @id @default(cuid())
  companyId String
  objectId  String
  name      String
  type      ObjectAreaType @default(OTHER)
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  object    Object         @relation(fields: [objectId], references: [id], onDelete: Cascade)
  jobs      Job[]
  customerReportSnapshots CustomerReportSnapshot[]
  workdaySheetRows WorkdaySheetRow[]
  serviceAgreements ServiceAgreement[]

  @@index([companyId, objectId, name])
  @@index([companyId, type])
}

model ItemCategory {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  kind        ItemKind @default(OTHER)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items       Item[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@index([companyId, kind])
}

model Item {
  id           String           @id @default(cuid())
  companyId    String
  categoryId   String?
  customId     String
  name         String
  description  String?
  kind         ItemKind         @default(OTHER)
  unit         ItemUnit         @default(PIECE)
  trackingMode ItemTrackingMode @default(QUANTITY)
  quantity     Decimal          @default(0) @db.Decimal(14, 3)
  status       ItemStatus       @default(ACTIVE)
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category     ItemCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  jobCostLines JobCostLine[]

  @@unique([companyId, customId])
  @@index([companyId, name])
  @@index([companyId, categoryId])
  @@index([companyId, kind])
  @@index([companyId, status])
}

model JobCostLine {
  id               String      @id @default(cuid())
  companyId        String
  jobId            String
  itemId           String?
  kind             JobCostKind
  description      String
  quantity         Decimal     @db.Decimal(14, 3)
  unit             JobCostUnit
  unitCost         Decimal?    @db.Decimal(14, 2)
  totalCost        Decimal     @db.Decimal(14, 2)
  currency         String      @default("EUR") @db.VarChar(3)
  taxRate          Decimal?    @db.Decimal(5, 2)
  costDate         DateTime    @default(now())
  vendorName       String?
  receiptReference String?
  notes            String?
  createdByUserId  String
  updatedByUserId  String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  company          Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job              Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  item             Item?       @relation(fields: [itemId], references: [id], onDelete: SetNull)
  createdBy        User        @relation("JobCostLineCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy        User        @relation("JobCostLineUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  worksheetReviewActions WorksheetReviewAction[]

  @@index([companyId, jobId, costDate])
  @@index([companyId, kind])
  @@index([itemId])
  @@index([createdByUserId])
  @@index([updatedByUserId])
}

model Assignment {
  id              String               @id @default(cuid())
  companyId       String
  sourceType      AssignmentEntityType
  sourceId        String
  targetType      AssignmentEntityType
  targetId        String
  kind            AssignmentKind
  status          AssignmentStatus     @default(ACTIVE)
  startsAt        DateTime?
  endsAt          DateTime?
  notes           String?
  createdByUserId String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  company         Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy       User                 @relation("AssignmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([companyId, status])
  @@index([companyId, sourceType, sourceId])
  @@index([companyId, targetType, targetId])
  @@index([companyId, kind])
  @@index([companyId, startsAt])
  @@index([createdByUserId])
}
model CustomerReportSnapshot {
  id                         String               @id @default(cuid())
  companyId                  String
  reportNumber               String
  jobId                      String?
  customerId                 String?
  addressId                  String?
  objectId                   String?
  objectAreaId               String?
  type                       CustomerReportType
  status                     CustomerReportStatus @default(DRAFT)
  title                      String
  recipientName              String
  periodStart                DateTime?
  periodEnd                  DateTime?
  issueSummary               String?
  findingSummary             String?
  workPerformedSummary       String?
  workStillNeededSummary     String?
  followUpSummary            String?
  costSummaryText            String?
  internalNotes              String?
  snapshotCustomerName       String
  snapshotAddressLabel       String?
  snapshotAddressText        String
  snapshotObjectName         String?
  snapshotObjectAreaName     String?
  snapshotJobReference       String
  snapshotJobTitle           String
  snapshotCostGrandTotal     Decimal?             @db.Decimal(14, 2)
  snapshotCostCurrency       String?               @db.VarChar(3)
  snapshotCostBreakdown      Json?
  snapshotSourceData         Json
  createdByUserId            String
  approvedByUserId           String?
  approvedAt                 DateTime?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  company                    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job                        Job?                  @relation(fields: [jobId], references: [id], onDelete: SetNull)
  customer                   Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  address                    Address?              @relation(fields: [addressId], references: [id], onDelete: SetNull)
  object                     Object?               @relation(fields: [objectId], references: [id], onDelete: SetNull)
  objectArea                 ObjectArea?           @relation(fields: [objectAreaId], references: [id], onDelete: SetNull)
  createdBy                  User                  @relation("CustomerReportCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedBy                 User?                 @relation("CustomerReportApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict)

  @@unique([companyId, reportNumber])
  @@index([companyId, status, createdAt])
  @@index([companyId, type, createdAt])
  @@index([companyId, jobId, createdAt])
  @@index([companyId, customerId])
  @@index([companyId, addressId])
  @@index([companyId, objectId])
  @@index([companyId, objectAreaId])
  @@index([createdByUserId])
  @@index([approvedByUserId])
}

model WorkdaySheet {
  id                String             @id @default(cuid())
  companyId         String
  date              DateTime           @db.Date
  title             String?
  status            WorkdaySheetStatus @default(DRAFT)
  teamId            String?
  workerUserId      String?
  internalNotes     String?
  reviewNotes       String?
  createdByUserId   String
  sentByUserId      String?
  submittedByUserId String?
  reviewedByUserId  String?
  archivedByUserId  String?
  sentAt            DateTime?
  submittedAt       DateTime?
  reviewedAt        DateTime?
  archivedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  team              Team?              @relation(fields: [teamId], references: [id], onDelete: SetNull)
  worker            User?              @relation("WorkdaySheetWorker", fields: [workerUserId], references: [id], onDelete: SetNull)
  createdBy         User               @relation("WorkdaySheetCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  sentBy            User?              @relation("WorkdaySheetSentBy", fields: [sentByUserId], references: [id], onDelete: Restrict)
  submittedBy       User?              @relation("WorkdaySheetSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  reviewedBy        User?              @relation("WorkdaySheetReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  archivedBy        User?              @relation("WorkdaySheetArchivedBy", fields: [archivedByUserId], references: [id], onDelete: Restrict)
  rows              WorkdaySheetRow[]
  reviewActions     WorksheetReviewAction[]

  @@index([companyId, date, status])
  @@index([companyId, teamId, date])
  @@index([companyId, workerUserId, date])
  @@index([createdByUserId])
  @@index([sentByUserId])
  @@index([submittedByUserId])
  @@index([reviewedByUserId])
  @@index([archivedByUserId])
}

model WorkdaySheetRow {
  id           String       @id @default(cuid())
  companyId    String
  sheetId      String
  position     Int
  startTime    String?      @db.VarChar(5)
  endTime      String?      @db.VarChar(5)
  plannedText  String
  actualText   String?
  notes        String?
  customerId   String?
  addressId    String?
  objectId     String?
  objectAreaId String?
  jobId        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sheet        WorkdaySheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  address      Address?     @relation(fields: [addressId], references: [id], onDelete: SetNull)
  object       Object?      @relation(fields: [objectId], references: [id], onDelete: SetNull)
  objectArea   ObjectArea?  @relation(fields: [objectAreaId], references: [id], onDelete: SetNull)
  job          Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)
  reviewActions WorksheetReviewAction[]

  @@unique([sheetId, position])
  @@index([companyId, sheetId])
  @@index([companyId, customerId])
  @@index([companyId, addressId])
  @@index([companyId, objectId])
  @@index([companyId, objectAreaId])
  @@index([companyId, jobId])
}

model WorksheetReviewAction {
  id                      String                      @id @default(cuid())
  companyId               String
  sourceSheetId           String
  sourceRowId             String
  type                    WorksheetReviewActionType
  status                  WorksheetReviewActionStatus @default(COMPLETED)
  idempotencyKey          String                      @db.VarChar(191)
  requestFingerprint      String                      @db.VarChar(64)
  sourceSnapshot          Json
  destinationJobId        String
  destinationJobReference String
  destinationJobTitle     String
  destinationJobCostLineId String?
  destinationJobReportId   String?
  destinationCostDescription String?
  destinationReportSummary  String?
  createdByUserId         String
  completedAt             DateTime
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  company                 Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceSheet             WorkdaySheet                @relation(fields: [sourceSheetId], references: [id], onDelete: Restrict)
  sourceRow               WorkdaySheetRow             @relation(fields: [sourceRowId], references: [id], onDelete: Restrict)
  destinationJob          Job                         @relation(fields: [destinationJobId], references: [id], onDelete: Restrict)
  destinationJobCostLine  JobCostLine?                @relation(fields: [destinationJobCostLineId], references: [id], onDelete: Restrict)
  destinationJobReport    JobReport?                  @relation(fields: [destinationJobReportId], references: [id], onDelete: Restrict)
  createdBy               User                        @relation("WorksheetReviewActionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([companyId, sourceRowId, type])
  @@unique([companyId, idempotencyKey])
  @@index([companyId, sourceSheetId, createdAt])
  @@index([destinationJobId])
  @@index([destinationJobCostLineId])
  @@index([destinationJobReportId])
  @@index([createdByUserId])
}

model ServiceAgreement {
  id                  String                 @id @default(cuid())
  companyId           String
  title               String
  description         String?
  status              ServiceAgreementStatus @default(DRAFT)
  effectiveFrom       DateTime               @db.Date
  effectiveUntil      DateTime?              @db.Date
  timezone            String                 @default("Europe/Berlin") @db.VarChar(100)
  customerId          String?
  addressId           String?
  objectId            String?
  objectAreaId        String?
  internalNotes       String?
  createdByUserId     String
  updatedByUserId     String
  activatedByUserId   String?
  deactivatedByUserId String?
  archivedByUserId    String?
  activatedAt         DateTime?
  deactivatedAt       DateTime?
  archivedAt          DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  company             Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer            Customer?              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  address             Address?               @relation(fields: [addressId], references: [id], onDelete: Restrict)
  object              Object?                @relation(fields: [objectId], references: [id], onDelete: Restrict)
  objectArea          ObjectArea?            @relation(fields: [objectAreaId], references: [id], onDelete: Restrict)
  createdBy           User                   @relation("ServiceAgreementCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy           User                   @relation("ServiceAgreementUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  activatedBy         User?                  @relation("ServiceAgreementActivatedBy", fields: [activatedByUserId], references: [id], onDelete: Restrict)
  deactivatedBy       User?                  @relation("ServiceAgreementDeactivatedBy", fields: [deactivatedByUserId], references: [id], onDelete: Restrict)
  archivedBy          User?                  @relation("ServiceAgreementArchivedBy", fields: [archivedByUserId], references: [id], onDelete: Restrict)
  duties              RecurringObjectDuty[]

  @@index([companyId, status, effectiveFrom])
  @@index([companyId, customerId, status])
  @@index([companyId, objectId, status])
  @@index([companyId, objectAreaId])
  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@index([activatedByUserId])
  @@index([deactivatedByUserId])
  @@index([archivedByUserId])
}

model RecurringObjectDuty {
  id              String                    @id @default(cuid())
  companyId       String
  agreementId     String
  position        Int
  plannedText     String
  notes           String?
  cadenceUnit     RecurringDutyCadenceUnit
  cadenceInterval Int                       @default(1)
  firstDueDate    DateTime                  @db.Date
  startTime       String?                   @db.VarChar(5)
  endTime         String?                   @db.VarChar(5)
  isActive        Boolean                   @default(true)
  createdByUserId String
  updatedByUserId String
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  company         Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agreement       ServiceAgreement          @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  createdBy       User                      @relation("RecurringObjectDutyCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy       User                      @relation("RecurringObjectDutyUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)

  @@unique([agreementId, position])
  @@index([companyId, agreementId, isActive])
  @@index([companyId, firstDueDate, isActive])
  @@index([createdByUserId])
  @@index([updatedByUserId])
}
